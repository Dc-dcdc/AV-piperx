<mujoco model="piper_scene">
<!-- meshdir/texturedir="."：XML 中的 file 路径直接从 env/assets 开始写，例如 meshes/piperx/xxx.stl。 -->
  <compiler meshdir="." texturedir="."/>

  <include file="piperx_sim.xml"/>

  <statistic center="0 -0.1 0.2" extent="0.6" meansize="0.05"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="90" elevation="-20" offwidth="1280" offheight="1280"/>
    <quality shadowsize="8192"/>
    <map znear="0.05"/>
  </visual>

  <asset>
    <!-- Shared scene assets. -->
    <material name="black" rgba="0.15 0.15 0.15 1"/>
    <mesh name="d405_solid" file="meshes/cameras/d405_solid.stl"/>

    <!-- table extrusions and frame -->
    <mesh file="meshes/extrusion_2040_1200.stl"/>
    <mesh file="meshes/extrusion_2040_880.stl"/>
    <mesh file="meshes/extrusion_150.stl"/>
    <mesh file="meshes/corner_bracket.stl"/>
    <mesh file="meshes/extrusion_1220.stl"/>
    <mesh file="meshes/extrusion_1000.stl"/>
    <mesh file="meshes/angled_extrusion.stl"/>
    <mesh file="meshes/extrusion_600.stl"/>
    <mesh file="meshes/overhead_mount.stl"/>
    <mesh file="meshes/extrusion_2040_1000.stl"/>
    <mesh file="meshes/wormseye_mount.stl"/>
    <mesh name="extrusion_840" file="meshes/extrusion_1220.stl" scale="1 1 0.68852459016"/>

    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <texture type="2d" file="meshes/table_diffuse.png"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table" texture="table_diffuse"/>
    <material name="metal" rgba="0.517 0.529 0.537 1"/>
    <material name="depth_wall" rgba="0.45 0.48 0.50 1"/>
  </asset>

  <default>
    <!-- Shared visual/collision defaults. -->
    <default class="visual">
      <geom type="mesh" mass="0" group="2" material="black" contype="0" conaffinity="0"/>
    </default>
    <default class="collision">
      <geom group="3" type="mesh" condim="6" friction="1 5e-3 5e-4" solref=".01 1"/>
    </default>
    <default class="frame">
      <geom group="1" type="mesh" material="black"/>
    </default>
  </default>

  <worldbody>
  <light pos="0 1 1.5" dir="0 0 -1" directional="true"/>
    <site name="origin" pos="0 0 0" group="5"/>
    <site name="worldref" pos="0 0 -0.75" group="5"/>
    <!-- Table dimensions (length x width x height in meters): 1.22x0.74x0.75. -->
    <geom name="tabletop_visual" type="box" material="table" class="visual" pos="0 0 -0.025" size="0.61 0.7 0.025"/>
    <geom name="table_leg_front_left" type="box" material="table" class="visual" pos="-0.55 -0.31 -0.40" size="0.035 0.035 0.35"/>
    <geom name="table_leg_front_right" type="box" material="table" class="visual" pos="0.55 -0.31 -0.40" size="0.035 0.035 0.35"/>
    <geom name="table_leg_back_left" type="box" material="table" class="visual" pos="-0.55 0.31 -0.40" size="0.035 0.035 0.35"/>
    <geom name="table_leg_back_right" type="box" material="table" class="visual" pos="0.55 0.31 -0.40" size="0.035 0.035 0.35"/>
    <geom name="table" pos="0 0 -0.1009" size="0.61 0.7 0.1" type="box" class="collision"/>

    <!-- 深度背景挡板：只参与视觉和深度渲染，不参与碰撞，用于减少远处 zfar 深度像素。 -->
    <geom name="depth_wall_back" class="visual" type="box" material="depth_wall" pos="0 0.90 0.24" size="1.2 0.015 1"/>
    <!-- <geom name="depth_wall_front" class="visual" type="box" material="depth_wall" pos="0 -0.50 0.24" size="0.72 0.015 0.24"/> -->
    <geom name="depth_wall_left" class="visual" type="box" material="depth_wall" pos="-1.2 0 0.24" size="0.015 0.90 1"/>
    <geom name="depth_wall_right" class="visual" type="box" material="depth_wall" pos="1.2 0 0.24" size="0.015 0.90 1"/>

    <camera name="overhead_cam" pos="0 -0.303794 1.02524" fovy="58" mode="fixed" quat="0.976332 0.216277 0 0"/>
    <geom class="frame" pos="0 -0.303794 1.02524" quat="0 0 0.976296 0.21644" mesh="d405_solid"/>
    <camera name="worms_eye_cam" pos="0 -0.377167 0.0316055" fovy="58" mode="fixed" quat="0.672659 0.739953 0 0"/>
    <geom class="frame" pos="0 -0.377167 0.0316055" quat="0 0 -0.672367 -0.740218" mesh="d405_solid"/>
    <!-- <geom class="frame" pos="0.6 -0.5 1.0" quat="0 1 0 1" mesh="extrusion_2040_1200"/>
    <geom class="frame" pos="0.59 -0.5 1.07" quat="0 0 0 1" mesh="extrusion_2040_1000"/>
    <geom class="frame" pos="-0.59 -0.5 1.07" quat="0 0 0 1" mesh="extrusion_2040_1000"/>
    <geom class="frame" pos="0.59 -0.38 0.10" quat="0.923 0.382 0 0" material="metal" mesh="angled_extrusion"/>
    <geom class="frame" pos="-0.59 -0.38 0.10" quat="0.923 0.382 0 0" material="metal" mesh="angled_extrusion"/> -->

  </worldbody>
</mujoco>
